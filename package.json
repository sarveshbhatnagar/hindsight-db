{
  "name": "hindsight-db",
  "version": "0.1.0",
  "description": "Embedded hindsight database: historical events with point-in-time context, the decisions made, and the outcomes observed — without leaking the future into the past.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarveshbhatnagar/hindsight-db.git"
  },
  "homepage": "https://github.com/sarveshbhatnagar/hindsight-db#readme",
  "bugs": {
    "url": "https://github.com/sarveshbhatnagar/hindsight-db/issues"
  },
  "keywords": [
    "sqlite",
    "embedded",
    "time-series",
    "events",
    "vector-search",
    "backtesting",
    "point-in-time",
    "agents"
  ]
}
